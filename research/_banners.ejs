```{=html}
<div class="banner-list">
<%
  // Position comes from each project's `order`; `half: true` makes a half-width banner,
  // so two neighbouring halves share a row.
  const ordered = [...items].sort((a, b) => (Number(a.order) || 99) - (Number(b.order) || 99));
%>
<% for (const item of ordered) { %>
<%
  // Quarto rewrites href attributes for the published address but not URLs inside style,
  // so the picture path is made relative to this page (the site root) here.
  const banner = item.image ? item.image.replace(/^\//, '').replace('thumb.png', 'banner.png') : null;
%>
  <a class="banner<%= banner ? '' : ' banner-plain' %><%= item.half ? ' banner-half' : '' %>" href="<%- item.path %>">
    <% if (banner) { %>
    <span class="banner-pic" role="img" aria-label="<%= item['image-alt'] || '' %>" style="-webkit-mask-image:url('<%- banner %>');mask-image:url('<%- banner %>')"></span>
    <% } %>
    <% if (banner && item.overlay) { %>
    <span class="banner-pic banner-over" style="-webkit-mask-image:url('<%- banner.replace('banner.png', 'banner-over.png') %>');mask-image:url('<%- banner.replace('banner.png', 'banner-over.png') %>')"></span>
    <% } %>
    <span class="banner-text">
      <span class="banner-title"><%= item.title %></span>
      <span class="banner-desc"><%= item.description %></span>
    </span>
  </a>
<% } %>
</div>
```
